{
  "test_command": ["python3", "-m", "unittest", "-v"],
  "result": {
    "kind": "regex",
    "pattern": "^(?P<id>test_\\w+) \\([^)]*\\)(?: [^.]*)? \\.\\.\\. (?P<status>ok|FAIL|ERROR)$",
    "pass_values": ["ok"]
  },
  "new_tests": ["test_total_discount_capped", "test_cheapest_empty_is_none", "test_cheapest_picks_minimum"],
  "must_fail_on_baseline": ["test_total_discount_capped", "test_cheapest_empty_is_none"],
  "allow_green_on_both": [],
  "mutants": [
    {
      "id": "m1-discount-not-capped",
      "file": "cart.py",
      "find": "    capped = min(max(discount_percent, 0), 100)\n",
      "replace": "    capped = discount_percent\n",
      "expect": ["test_total_discount_capped"],
      "new_code_only": true
    },
    {
      "id": "m2-empty-cart-raises",
      "file": "cart.py",
      "find": "    if not prices:\n        return None\n",
      "replace": "",
      "expect": ["test_cheapest_empty_is_none"],
      "new_code_only": true
    },
    {
      "id": "m3-cheapest-returns-max",
      "file": "cart.py",
      "find": "    return min(prices)\n",
      "replace": "    return max(prices)\n",
      "expect": ["test_cheapest_picks_minimum"]
    }
  ]
}
